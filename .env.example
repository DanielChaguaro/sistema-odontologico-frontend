# Copia este archivo como .env.local (no se versiona) y completa los valores.
# URL del API Gateway del backend.
VITE_API_URL=http://127.0.0.1:8080
# Mismo valor que GATEWAY_CLIENT_TOKEN del backend. Es un identificador de cliente, no un secreto de usuario:
# viaja en el navegador. La seguridad real la dan el JWT y los permisos de identity.
VITE_CLIENT_TOKEN=
